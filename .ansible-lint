---

# Found from any subdirectory: ansible-lint walks up from its working directory
# and stops at .git.
#
# Roles are linted one at a time as they are picked up ('task lint' inside a
# role directory, also run by 'task test'), so a role that has not been cleaned
# up yet is expected to fail. Fix the role rather than adding to skip_list.

profile: production

exclude_paths:
  - temp/
